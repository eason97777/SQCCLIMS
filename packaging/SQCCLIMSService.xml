<service>
  <id>SQCCLIMSService</id>
  <name>SQCCLIMS Service</name>
  <description>SQCCLIMS sample testing information management center backend service.</description>
  <executable>%BASE%\app\server.exe</executable>
  <arguments>--host 0.0.0.0 --port 8000 --data-dir F:\soft\SQCCLIMSData</arguments>
  <workingdirectory>%BASE%\app</workingdirectory>
  <logpath>F:\soft\SQCCLIMSData\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec" />
  <startmode>Automatic</startmode>
</service>
